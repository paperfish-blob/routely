# Routely backend configuration. Copy to .env and adjust.

# Nominatim requires an identifying User-Agent with a contact address.
ROUTELY_NOMINATIM_USER_AGENT="Routely/0.1 (set contact email in .env)"
ROUTELY_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Public Nominatim policy: max 1 request/second.
ROUTELY_GEOCODE_MIN_INTERVAL_S=1.0
ROUTELY_GEOCODE_CACHE_TTL_S=86400
ROUTELY_GEOCODE_CACHE_MAX_ENTRIES=1000

# OSRM public servers. Not for heavy use.
# The demo server only serves the car profile (it ignores the profile in the URL),
# so walking uses a separate foot-profile instance.
ROUTELY_OSRM_BASE_URL=https://router.project-osrm.org
ROUTELY_OSRM_WALKING_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTELY_OSRM_TIMEOUT_S=8.0

# Default single-linkage clustering threshold.
ROUTELY_CLUSTER_THRESHOLD_KM=5.0

# JSON list of allowed browser origins.
ROUTELY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
